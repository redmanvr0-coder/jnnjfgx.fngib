N2Tab:CreateDropdown({
    Name = "Delivery:",
    Options = {"Camera", "Lock", "UVLamp", "MotionSensor", "None"},
    CurrentOption = {"None"},
    MultipleOptions = false,
    Flag = "DeliveryDropdown",
    Callback = function(Value)
        local delivery = Remotes and Remotes:FindFirstChild("Delivery")
        if delivery then
            delivery:FireServer(getSelectedOption(Value))
        end
    end
})

N2Tab:CreateDropdown({
    Name = "Repair Wire:",
    Options = {"1", "2", "3", "4", "None"},
    CurrentOption = {"None"},
    MultipleOptions = false,
    Flag = "RepairWireDropdown",
    Callback = function(Value)
        local selected = getSelectedOption(Value)
        local repair = Remotes and Remotes:FindFirstChild("Repair")
        if repair then
            repair:FireServer(selected)
        end
        Rayfield:Notify({
            Title = "NIGHT 2",
            Content = "Repairing: " .. tostring(selected) .. " (If RepairWorker isn't dead)",
            Duration = 5,
            Image = 4483362458
        })
    end
})

