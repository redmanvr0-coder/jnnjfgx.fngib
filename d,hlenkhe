local function TpNearestLiveAmmo()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local nearestPart = nil
    local bestDist = math.huge
    local container = ResolvePath(PATH_AMMOPILES)
    if not container then
        warn("Container not found for Live Ammo TP.")
        return
    end
    for _, pile in ipairs(container:GetChildren()) do
        local shells = pile:FindFirstChild("Shells")
        local logPart = pile:FindFirstChild("Log")
        if shells and logPart and logPart:IsA("BasePart") then
            local dist = (root.Position - logPart.Position).Magnitude
            if dist < bestDist then
                bestDist = dist
                nearestPart = logPart
            end
        end
    end
    if nearestPart then
        SafeCFrameTP(nearestPart.CFrame)
    else
        warn("No active ammo pile found for TP.")
    end
end

local function TpNearestActiveJerryCan()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local nearestPart = nil
    local bestDist = math.huge
    local container = ResolvePath(PATH_JERRYCANS)
    if not container then
        warn("Container not found for Active JerryCan TP.")
        return
    end
    for _, can in ipairs(container:GetChildren()) do
        local mainPart = can:FindFirstChild("Main")
        if mainPart and mainPart:IsA("BasePart") and mainPart.CanCollide == true then
            local dist = (root.Position - mainPart.Position).Magnitude
            if dist < bestDist then
                bestDist = dist
                nearestPart = mainPart
            end
        end
    end
    if nearestPart then
        SafeCFrameTP(nearestPart.CFrame)
    else
        warn("No active JerryCan found for TP.")
    end
end

local function SpawnItemClientOrRemote(itemName)
    local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
    local giveItemRemote = remotesFolder and remotesFolder:FindFirstChild("GiveItem")
    if giveItemRemote and giveItemRemote:IsA("RemoteEvent") then
        giveItemRemote:FireServer(itemName)
        return
    end
    local itemsFolder = ReplicatedStorage:FindFirstChild("Items")
    if not itemsFolder then
        warn("Folder 'Items' not found in ReplicatedStorage.")
        return
    end
    local template = itemsFolder:FindFirstChild(itemName)
    if template and template:IsA("Tool") and LocalPlayer:FindFirstChild("Backpack") then
        local clone = template:Clone()
        clone.Parent = LocalPlayer.Backpack
    else
        warn("Item '" .. itemName .. "' not found or is not a Tool.")
    end
end

