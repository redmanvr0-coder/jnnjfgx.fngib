N2Tab:CreateButton({
    Name = "Refill Power",
    Callback = function()
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local powerCell = Workspace:FindFirstChild("PowerCell")
        local generator = Workspace:FindFirstChild("Generator")
        if root and powerCell and generator and generator:FindFirstChild("Detector") then
            local oCFrame = root.CFrame
            root.CFrame = CFrame.new(-318.606567, 82.3999634, 97.8991776, -0.0253890008, -5.39555138e-08, -0.999677658, 3.64161301e-09, 1, -5.40653993e-08, 0.999677658, -5.01310549e-09, -0.0253890008)
            task.wait(0.25)
            fireclickdetector(powerCell.ClickDetector)
            task.wait(0.25)
            root.CFrame = CFrame.new(-271.368439, 82.3999634, 112.977608, -0.9987728, -3.20747908e-08, 0.0495270789, -2.73038125e-08, 1, 9.70072804e-08, -0.0495270789, 9.55359525e-08, -0.9987728)
            task.wait(0.25)
            fireclickdetector(generator.Detector.ClickDetector)
            task.wait(0.25)
            root.CFrame = oCFrame
        end
        Rayfield:Notify({ Title = "NIGHT 2", Content = "Refilled power!", Duration = 5, Image = 4483362458 })
    end
})

N2Tab:CreateParagraph({
    Title = "ANTIS",
    Content = "Some Buttons that make you immune to certain things are located down there."
})

N2Tab:CreateButton({
    Name = "Disable Stalker View DMG",
    Callback = function()
        local lookAt = Remotes and Remotes:FindFirstChild("LookAt")
        if lookAt then
            lookAt:Destroy()
        end
        Rayfield:Notify({ Title = "STALKER", Content = "You're immune to Stalker view damage now.", Duration = 5, Image = 4483362458 })
    end
})

N2Tab:CreateButton({
    Name = "Anti Vent-Pests",
    Callback = function()
        local grids = Workspace:FindFirstChild("Grids")
        if grids then
            for _, gridel in grids:GetChildren() do
                if gridel:IsA("Model") then
                    for _, child in gridel:GetChildren() do
                        if child:IsA("Part") and child.Name == "Hitbox" then
                            child:Destroy()
                        end
                    end
                end
            end
        end
        Rayfield:Notify({ Title = "PESTS", Content = "You're immune to Vent Pest's snatch now.", Duration = 5, Image = 4483362458 })
    end
})

