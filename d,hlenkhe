local function StartCabinWarning()
    local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
    local openDoorRemote = remotesFolder and remotesFolder:FindFirstChild("OpenDoor")
    if not openDoorRemote or not openDoorRemote:IsA("RemoteEvent") then
        NotifyWarning("Config Alert", "RemoteEvent 'OpenDoor' not found in this game.")
        return
    end
    if CabinDoorConnection then
        CabinDoorConnection:Disconnect()
    end
    CabinDoorConnection = openDoorRemote.OnClientEvent:Connect(function(intruder, doorObj)
        local actorName = "Someone (Possibly Bot)"
        if intruder and intruder:IsA("Player") then
            if intruder == LocalPlayer then
                return
            end
            actorName = intruder.Name
        end
        local doorName = (typeof(doorObj) == "Instance" and doorObj.Name) or "a door"
        NotifyWarning("INTRUDER DETECTED", actorName .. " is trying to open " .. doorName .. "!")
    end)
    NotifyWarning("Detector Active", "Listening for 'OpenDoor' client events.")
end

local function SetCabinWarning(enabled)
    State.CabinWarning = enabled
    if enabled then
        StartCabinWarning()
    elseif CabinDoorConnection then
        CabinDoorConnection:Disconnect()
        CabinDoorConnection = nil
        NotifyWarning("Detector Disabled", "Cabin intrusion warning is off.")
    end
end

