local function ResolvePath(pathStr)
    local parts = pathStr:split(".")
    local current = Workspace

    if parts[1] == NAME_MUTANT or parts[1] == NAME_WORKER or parts[1] == NAME_GHOST then
        local fromRS = ReplicatedStorage:FindFirstChild(parts[1])
        if fromRS then
            return fromRS
        end
    end

    if pathStr:find("ReplicatedStorage") == 1 then
        current = ReplicatedStorage
        if parts[1] == "ReplicatedStorage" then
            table.remove(parts, 1)
        end
    end

    for _, partName in ipairs(parts) do
        if not current then
            return nil
        end
        current = current:FindFirstChild(partName)
    end

    return current
end

local function ResolveIndexedPath(pathStr)
    local str = pathStr
    if str:sub(1, 10) == "workspace." then
        str = str:sub(11)
    elseif str:sub(1, 18) == "ReplicatedStorage." then
        str = str:sub(19)
    end

    local current = pathStr:find("ReplicatedStorage") == 1 and ReplicatedStorage or Workspace
    for _, segment in ipairs(str:split(".")) do
        if not current then
            return nil
        end
        local baseName, indexStr = segment:match("^(.*)%[([0-9]+)%]$")
        if indexStr then
            local parentObj = current:FindFirstChild(baseName)
            local idx = tonumber(indexStr)
            if not parentObj or not idx or idx < 1 then
                return nil
            end
            local children = parentObj:GetChildren()
            if idx > #children then
                return nil
            end
            current = children[idx]
        else
            current = current:FindFirstChild(segment)
        end
    end
    return current
end

local function TeleportToIndexedPath(pathStr)
    local target = ResolveIndexedPath(pathStr)
    local targetPart = nil
    if target then
        if target:IsA("BasePart") then
            targetPart = target
        elseif target:IsA("Model") then
            targetPart = target.PrimaryPart or target:FindFirstChildOfClass("BasePart", true)
        else
            targetPart = target:FindFirstChildOfClass("BasePart", true)
        end
    end
    if targetPart and targetPart:IsA("BasePart") then
        SafeCFrameTP(targetPart.CFrame)
    else
        warn("TP Error: Target part not found at path:", pathStr)
    end
end

local function SetHighlight(target, enabled, color, fullFill)
    local existing = ActiveHighlights[target]
    if enabled then
        if not existing then
            local hl = Instance.new("Highlight")
            hl.Name = target.Name .. "_ESP"
            hl.OutlineColor = color
            hl.OutlineTransparency = 0
            hl.FillColor = color
            hl.FillTransparency = fullFill and 1 or 0.5
            hl.Enabled = true
            hl.Parent = target
            ActiveHighlights[target] = hl
        else
            existing.OutlineColor = color
            existing.FillColor = color
            existing.FillTransparency = fullFill and 1 or 0.5
            existing.Enabled = true
        end
    elseif existing then
        existing:Destroy()
        ActiveHighlights[target] = nil
    end
end

local function SetNameTag(target, enabled, labelText, textColor)
    local existing = ActiveNameTags[target]
    if enabled and State.Names then
        if not existing then
            local gui = Instance.new("BillboardGui")
            gui.Name = target.Name .. "_NameTag"
            gui.AlwaysOnTop = true
            gui.Size = UDim2.new(0, 80, 0, 12)
            gui.StudsOffset = Vector3.new(0, 1.2, 0)

            local label = Instance.new("TextLabel")
            label.Text = labelText
            label.TextScaled = true
            label.Font = Enum.Font.Code
            label.TextSize = 12
            label.TextColor3 = textColor
            label.BackgroundTransparency = 0
            label.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            label.Size = UDim2.new(1, 0, 1, 0)
            label.Parent = gui

            gui.Parent = target
            ActiveNameTags[target] = gui
        end
    elseif existing then
        existing:Destroy()
        ActiveNameTags[target] = nil
    end
end

local function UpdateESP()
    local anyEspActive = State.Zombies or State.Pumpkins or State.JerryCans or State.Mutant
        or State.Worker or State.Cabins or State.ItemSpots or State.Shotgun
        or State.LiveAmmo or State.Ghost
    if not anyEspActive then
        return
    end

    local tracked = {}

    if State.Zombies then
        local container = ResolvePath(PATH_ZOMBIES)
        if container then
            for _, obj in ipairs(container:GetChildren()) do
                if obj:IsA("BasePart") or obj:IsA("Model") then
                    SetHighlight(obj, true, ESP_COLORS.Zombies, false)
                    SetNameTag(obj, true, "ZOMBIE", ESP_COLORS.Zombies)
                    tracked[obj] = true
                end
            end
        end
    end

    if State.Pumpkins then
        local container = ResolvePath(PATH_PUMPKINS)
        if container then
            for _, obj in ipairs(container:GetChildren()) do
                if obj:IsA("BasePart") or obj:IsA("Model") then
                    SetHighlight(obj, true, ESP_COLORS.Pumpkins, false)
                    SetNameTag(obj, true, "PUMPKIN ITEM", ESP_COLORS.Pumpkins)
                    tracked[obj] = true
                end
            end
        end
    end

    if State.JerryCans then
        local container = ResolvePath(PATH_JERRYCANS)
        if container then
            if container:IsA("BasePart") or container:IsA("Model") then
                SetHighlight(container, true, ESP_COLORS.JerryCans, false)
                SetNameTag(container, true, "JERRYCAN GAS", ESP_COLORS.JerryCans)
                tracked[container] = true
            else
                for _, obj in ipairs(container:GetChildren()) do
                    if obj:IsA("BasePart") or obj:IsA("Model") then
                        SetHighlight(obj, true, ESP_COLORS.JerryCans, false)
                        SetNameTag(obj, true, "JERRYCAN GAS", ESP_COLORS.JerryCans)
                        tracked[obj] = true
                    end
                end
            end
        end
    end

    if State.Cabins then
        local container = ResolvePath(PATH_CABINS)
        if container then
            for _, obj in ipairs(container:GetChildren()) do
                if obj:IsA("BasePart") or obj:IsA("Model") then
                    SetHighlight(obj, true, ESP_COLORS.Cabins, true)
                    SetNameTag(obj, true, "CABIN", ESP_COLORS.Cabins)
                    tracked[obj] = true
                end
            end
        end
    end

    if State.ItemSpots then
        local container = ResolvePath(PATH_ITEMSPOTS)
        if container then
            for _, spot in ipairs(container:GetChildren()) do
                local target = spot:FindFirstChildOfClass("BasePart") or spot:FindFirstChildOfClass("Model")
                if target and (target:IsA("BasePart") or target:IsA("Model")) then
                    local upperName = target.Name:upper()
                    local col = ESP_COLORS.DefaultItem
                    local tagText = upperName
                    if upperName:find("MARSHMALLOW") then
                        col = ESP_COLORS.Marshmallow
                        tagText = "MARSHMALLOW"
                    elseif upperName:find("CAMERA") then
                        col = ESP_COLORS.Camera
                        tagText = "CAMERA"
                    elseif upperName:find("BATTERY") then
                        col = ESP_COLORS.Battery
                        tagText = "BATTERY"
                    elseif upperName:find("SHOTGUN") or upperName:find("AMMO") then
                        col = ESP_COLORS.Shotgun
                        tagText = "SHOTGUN AMMO"
                    end
                    SetHighlight(target, true, col, false)
                    SetNameTag(target, true, tagText, col)
                    tracked[target] = true
                end
            end
        end
    end

    if State.Shotgun then
        local worldShotgun = Workspace:FindFirstChild(NAME_SHOTGUN)
        if worldShotgun and (worldShotgun:IsA("BasePart") or worldShotgun:IsA("Model")) then
            SetHighlight(worldShotgun, true, ESP_COLORS.Shotgun, false)
            SetNameTag(worldShotgun, true, "SHOTGUN (W)", ESP_COLORS.Shotgun)
            tracked[worldShotgun] = true
        else
            local char = LocalPlayer.Character
            local equipped = char and char:FindFirstChild(NAME_SHOTGUN)
            if equipped and equipped:IsA("Model") then
                local part = equipped.PrimaryPart or equipped:FindFirstChildOfClass("BasePart")
                if part then
                    SetHighlight(part, true, ESP_COLORS.Shotgun, false)
                    SetNameTag(part, true, "SHOTGUN (E)", ESP_COLORS.Shotgun)
                    tracked[part] = true
                end
            end
        end
    end

    if State.Mutant then
        local mutant = Workspace:FindFirstChild(NAME_MUTANT) or ReplicatedStorage:FindFirstChild(NAME_MUTANT)
        if mutant then
            for _, partName in ipairs(MutantParts) do
                local part = mutant:FindFirstChild(partName)
                if part and (part:IsA("BasePart") or part:IsA("Model")) then
                    SetHighlight(part, true, ESP_COLORS.Mutant, false)
                    if partName == "Head" then
                        SetNameTag(part, true, "MUTANT", ESP_COLORS.Mutant)
                    end
                    tracked[part] = true
                end
            end
        end
    end

    if State.Worker then
        local worker = Workspace:FindFirstChild(NAME_WORKER) or ReplicatedStorage:FindFirstChild(NAME_WORKER)
        if worker then
            for _, partName in ipairs(WorkerParts) do
                local part = worker:FindFirstChild(partName)
                if part and (part:IsA("BasePart") or part:IsA("Model")) then
                    SetHighlight(part, true, ESP_COLORS.Worker, false)
                    if partName == "Head" then
                        SetNameTag(part, true, "SPIDER", ESP_COLORS.Worker)
                    end
                    tracked[part] = true
                end
            end
        end
    end

    if State.Ghost then
        local ghost = Workspace:FindFirstChild(NAME_GHOST) or ReplicatedStorage:FindFirstChild(NAME_GHOST)
        if ghost then
            for _, partName in ipairs(GhostParts) do
                local part = ghost:FindFirstChild(partName)
                if part and (part:IsA("BasePart") or part:IsA("Model")) then
                    SetHighlight(part, true, ESP_COLORS.Ghost, false)
                    if partName == "Head" then
                        SetNameTag(part, true, "GHOST", ESP_COLORS.Ghost)
                    end
                    tracked[part] = true
                end
            end
        end
    end

    if State.LiveAmmo then
        local ammoContainer = ResolvePath(PATH_AMMOPILES)
        if ammoContainer then
            for _, pile in ipairs(ammoContainer:GetChildren()) do
                if pile:IsA("Model") or pile:IsA("BasePart") then
                    local logPart = pile:FindFirstChild("Log")
                    local shellsPart = pile:FindFirstChild("Shells")
                    if logPart and shellsPart then
                        SetHighlight(logPart, true, ESP_COLORS.AmmoLog, false)
                        SetHighlight(shellsPart, true, ESP_COLORS.AmmoShells, false)
                        SetNameTag(logPart, true, "LIVE AMMO", ESP_COLORS.AmmoShells)
                        tracked[logPart] = true
                        tracked[shellsPart] = true
                    end
                end
            end
        end
    end

    for obj in pairs(ActiveHighlights) do
        if not tracked[obj] or not obj.Parent then
            SetHighlight(obj, false)
        end
    end

    for obj in pairs(ActiveNameTags) do
        if not tracked[obj] or not obj.Parent or not State.Names then
            SetNameTag(obj, false)
        end
    end
end

local function RefreshEspLoop()
    local anyEspActive = State.Zombies or State.Pumpkins or State.JerryCans or State.Mutant
        or State.Worker or State.Cabins or State.ItemSpots or State.Shotgun
        or State.LiveAmmo or State.Ghost
    if anyEspActive and not EspConnection then
        EspConnection = RunService.RenderStepped:Connect(UpdateESP)
    elseif not anyEspActive and EspConnection then
        EspConnection:Disconnect()
        EspConnection = nil
        for obj in pairs(ActiveHighlights) do
            SetHighlight(obj, false)
        end
        for obj in pairs(ActiveNameTags) do
            SetNameTag(obj, false)
        end
    end
end

local function StepNoclip()
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end

local function StepGodmode()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.MaxHealth = 10000
        if hum.Health < 100 then
            hum.Health = 100
        end
        local state = hum:GetState()
        if state ~= Enum.HumanoidStateType.Running
            and state ~= Enum.HumanoidStateType.Jumping
            and state ~= Enum.HumanoidStateType.Freefall
            and state ~= Enum.HumanoidStateType.Seated then
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    elseif char and not hum then
        warn("GODMODE ALERT: Humanoid was destroyed. Attempting respawn.")
        LocalPlayer:LoadCharacter()
    end
end

local function StepBattery()
    local char = LocalPlayer.Character
    local bat = char and char:FindFirstChild(NAME_FLASHLIGHT) and char[NAME_FLASHLIGHT]:FindFirstChild("Battery")
    if not bat and LocalPlayer:FindFirstChild("Backpack") then
        local tool = LocalPlayer.Backpack:FindFirstChild(NAME_FLASHLIGHT)
        bat = tool and tool:FindFirstChild("Battery")
    end
    if bat and bat:IsA("NumberValue") then
        bat.Value = math.huge
    end
end

local function StepStamina()
